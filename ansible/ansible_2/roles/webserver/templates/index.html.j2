<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ ansible_facts.hostname }} - System Info</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        .container {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 50px 60px;
            max-width: 700px;
            width: 100%;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: 0.3s;
        }
        .container:hover {
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8);
            transform: scale(1.01);
        }
        h1 {
            font-size: 2.8em;
            margin-bottom: 20px;
            text-align: center;
            background: linear-gradient(90deg, #f7971e, #ffd200);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
            letter-spacing: -1px;
        }
        .subtitle {
            text-align: center;
            font-size: 1em;
            color: #aaa;
            margin-bottom: 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 15px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 30px;
            background: rgba(0, 0, 0, 0.25);
            border-radius: 16px;
            padding: 25px 30px;
            margin-bottom: 25px;
        }
        .info-item {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }
        .info-item.full {
            grid-column: span 2;
        }
        .label {
            color: #9b9b9b;
            font-weight: 300;
            letter-spacing: 0.3px;
        }
        .value {
            color: #fff;
            font-weight: 600;
            font-family: 'Courier New', monospace;
            font-size: 0.95em;
            word-break: break-all;
            text-align: right;
        }
        .badge-container {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 10px;
        }
        .badge {
            background: rgba(255, 255, 255, 0.07);
            padding: 6px 18px;
            border-radius: 30px;
            font-size: 0.8em;
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: #ccc;
            letter-spacing: 0.3px;
        }
        .badge.green {
            border-color: #2ecc71;
            color: #2ecc71;
        }
        .footer {
            margin-top: 25px;
            text-align: center;
            font-size: 0.75em;
            color: #666;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            padding-top: 18px;
        }
        .footer strong {
            color: #888;
        }
        @media (max-width: 600px) {
            .container { padding: 30px 20px; }
            .info-grid { grid-template-columns: 1fr; }
            .info-item.full { grid-column: span 1; }
            h1 { font-size: 2em; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1> {{ ansible_facts.hostname }}</h1>
        <div class="subtitle">System Information · Managed by Ansible</div>

        <div class="info-grid">
            <div class="info-item full">
                <span class="label"> IP Address</span>
                <span class="value">{{ ansible_facts.default_ipv4.address }}</span>
            </div>
            <div class="info-item">
                <span class="label"> Hostname</span>
                <span class="value">{{ ansible_facts.hostname }}</span>
            </div>
            <div class="info-item">
                <span class="label"> OS</span>
                <span class="value">{{ ansible_facts.distribution }} {{ ansible_facts.distribution_version }}</span>
            </div>
            <div class="info-item">
                <span class="label"> Kernel</span>
                <span class="value">{{ ansible_facts.kernel }}</span>
            </div>
            <div class="info-item">
                <span class="label"> CPU</span>
                <span class="value">{{ ansible_facts.processor_cores }} cores ({{ ansible_facts.processor_count }} threads)</span>
            </div>
            <div class="info-item">
                <span class="label"> Memory</span>
                <span class="value">{{ ansible_facts.memory_mb.real.total }} MB</span>
            </div>
            <div class="info-item full">
                <span class="label"> First HDD</span>
                <span class="value">
                    {% set disk = ansible_facts.devices | first %}
                    {{ ansible_facts.devices[disk].size | default('N/A') }}
                </span>
            </div>
        </div>

        <div class="badge-container">
            <span class="badge green"> Apache2</span>
            <span class="badge"> {{ ansible_facts.date_time.date }}</span>
            <span class="badge">⏱ {{ ansible_facts.uptime_seconds }}s uptime</span>
        </div>

        <div class="footer">
            <strong>Deployed by Ansible</strong> · {{ ansible_facts.date_time.iso8601 }}
        </div>
    </div>
</body>
</html>